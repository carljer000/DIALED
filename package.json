{
  "name": "dialed",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "postinstall": "npm run install:all",
    "dev": "concurrently --kill-others-on-fail --names API,CLIENT --prefix-colors red,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "seed": "npm run db:seed --prefix server",
    "supabase:login": "supabase login --agent no",
    "supabase:link": "supabase link",
    "supabase:push": "supabase db push --linked",
    "supabase:migrations": "supabase migration list --linked",
    "db:migrate-data": "npm run db:migrate:supabase --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "supabase": "2.117.0"
  }
}
