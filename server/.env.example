PORT=3001
# Copy the Session pooler URI from Supabase Dashboard > Connect.
# Percent-encode reserved characters in the password. TLS verification is
# configured with server/certs/prod-ca-2021.crt in src/config/database.js.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DB_POOL_MAX=5
CLIENT_ORIGIN=http://localhost:5173

# Only needed temporarily by `npm run db:migrate-data`.
SOURCE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dialed
