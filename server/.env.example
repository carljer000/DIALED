PORT=3001
# On Vercel, copy the Transaction pooler URI from Supabase Dashboard > Connect.
# Percent-encode reserved characters in the password. TLS verification is
# configured with server/certs/prod-ca-2021.crt in src/config/database.js.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
DB_POOL_MAX=1
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Sign in once, then copy your immutable Supabase Auth user UUID here.
OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# Only needed temporarily by `npm run db:migrate-data`.
SOURCE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dialed
